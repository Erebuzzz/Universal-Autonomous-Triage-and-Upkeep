# Local runtime
UATU_DATA_DIR=./data
# Seed copied into an isolated sandbox under UATU_DATA_DIR/sandbox/
UATU_FIXTURE_SEED=./fixtures/demo-vulnerable
# Optional override for the writable sandbox path (defaults to data/sandbox/demo-vulnerable)
# UATU_FIXTURE_PATH=./data/sandbox/demo-vulnerable
UATU_PASSIVE_MODE=true
UATU_API_PORT=8787
UATU_CORS_ORIGIN=http://localhost:5173
# UATU_CORS_CREDENTIALS=true
# UATU_WEB_ORIGIN=http://localhost:5173
# UATU_COOKIE_SECURE=false
# UATU_COOKIE_SAMESITE=Lax
# UATU_AUTH_REQUIRED=false
# Deployed CDK stacks default UATU_AUTH_REQUIRED=true (fail closed). Local demo: set false.

# Detection path: auto (default) tries general then falls back to fixture;
# fixture = hardcoded demo detectors; general = npm audit + static + optional LLM.
# UATU_DETECTION_MODE=auto

# Optional Amazon Bedrock (deterministic rules used when unset)
UATU_BEDROCK_ENABLED=false
UATU_BEDROCK_REGION=ap-south-1
# Prefer an APAC inference profile id available in ap-south-1, e.g. apac.amazon.nova-micro-v1:0
UATU_BEDROCK_MODEL_ID=apac.amazon.nova-micro-v1:0
# AWS_PROFILE=erebuzzz

# Optional live GitHub contribution — classic PAT (local) OR GitHub App (market)
UATU_GITHUB_TOKEN=
UATU_GITHUB_REPO=
UATU_GITHUB_BASE_BRANCH=main
UATU_GITHUB_WEBHOOK_SECRET=
# UATU_GITHUB_API_BASE=https://api.github.com

# GitHub App (API/Lambda only — never Vercel)
# UATU_GITHUB_APP_ID=
#UATU_GITHUB_APP_PRIVATE_KEY=

# UATU_GITHUB_APP_INSTALLATION_ID=

# GitHub OAuth for dashboard (API/Lambda only — never expose secret to browser/Vercel)
# UATU_GITHUB_OAUTH_CLIENT_ID=
# UATU_GITHUB_OAUTH_CLIENT_SECRET=
# UATU_GITHUB_OAUTH_CALLBACK_URL=http://localhost:8787/auth/github/callback

# Quotas (per user)
# UATU_QUOTA_MAX_CONCURRENT=1
# UATU_QUOTA_MAX_DAILY=20
# UATU_QUOTA_MAX_MONTHLY=200
# UATU_RUN_WALL_CLOCK_MS=600000

# AWS deploy (Ship It) — set to your project Region (AWS Settings)
# Do not commit real account IDs or profile names.
CDK_DEFAULT_ACCOUNT=
CDK_DEFAULT_REGION=ap-south-1
# AWS_PROFILE=YOUR_AWS_PROFILE

# Web (Vite) — public only; never put OAuth secrets / App private keys / tokens here
# VITE_UATU_API_URL=
# VITE_UATU_MOCK_AUTH=true
# Public App slug from https://github.com/apps/<slug> (required for install links; no default)
# VITE_UATU_GITHUB_APP_SLUG=uatu-agent
