# Local runtime
UATU_DATA_DIR=./data
# Seed copied into an isolated sandbox under UATU_DATA_DIR/sandbox/
UATU_FIXTURE_SEED=./fixtures/demo-vulnerable
# Optional override for the writable sandbox path (defaults to data/sandbox/demo-vulnerable)
# UATU_FIXTURE_PATH=./data/sandbox/demo-vulnerable
UATU_PASSIVE_MODE=true
UATU_API_PORT=8787
UATU_CORS_ORIGIN=http://localhost:5173

# Optional Amazon Bedrock (deterministic rules used when unset)
UATU_BEDROCK_ENABLED=false
UATU_BEDROCK_REGION=ap-south-1
UATU_BEDROCK_MODEL_ID=

# AWS deploy (Ship It) — new AWS experience uses the project Region
CDK_DEFAULT_ACCOUNT=
CDK_DEFAULT_REGION=ap-south-1
