{
  "buildCommand": "npm run build -w @uatu/web",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "rewrites": [],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
